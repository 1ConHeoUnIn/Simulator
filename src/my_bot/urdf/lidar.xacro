<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- KHỚP NỐI TRỤ ĐỠ THÁP (Cao 0.15m đặt trên nóc thân xe) -->
    <!-- Nóc xe ở Z = 0.3m (gầm 0.1m + thân 0.2m), đặt trụ cao 0.15m lên nóc -->
    <joint name="laser_tower_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_tower"/>
        <origin xyz="0.25 0 0.3" rpy="0 0 0"/>
    </joint>

    <link name="laser_tower">
        <visual>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.02" length="0.15"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.02" length="0.15"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.2" length="0.15" radius="0.02">
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_tower">
        <material>Gazebo/Black</material>
    </gazebo>

    <!-- KHỚP NỐI MẮT ĐỌC RPLIDAR C1 (Đặt trên đỉnh trụ tháp) -->
    <joint name="laser_joint" type="fixed">
        <parent link="laser_tower"/>
        <child link="laser_frame"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.028" length="0.041"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.028" length="0.041"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.11" length="0.041" radius="0.028">
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_frame">
        <material>Gazebo/Orange</material>

        <sensor name="laser" type="ray">
            <pose> 0 0 0.02 0 0 0 </pose>
            
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <!-- 360 độ / 0.72 độ = 500 mẫu quét -->
                        <samples>500</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159265</min_angle>
                        <max_angle>3.14159265</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <!-- Thông số RPLIDAR C1: 0.05m đến 12.0m -->
                    <min>0.05</min>
                    <max>12.0</max>
                    <resolution>0.013</resolution>
                </range>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <argument>~/out:=scan</argument>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>