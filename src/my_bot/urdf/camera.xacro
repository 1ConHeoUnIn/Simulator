<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="silver">
        <color rgba="0.75 0.75 0.75 1.0"/>
    </material>
    <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>

    <!-- 1. CHÂN ĐẾ GIMBAL (Tiếp xúc trực tiếp nóc thùng xe tại Z = 0.30m) -->
    <link name="camera_pan_base">
        <visual>
            <origin xyz="0 0 0.002" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.06 0.004"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.002" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.06 0.004"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.05" x="0.06" y="0.06" z="0.004">
            <origin xyz="0 0 0.002" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="camera_pan_base_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_pan_base"/>
        <origin xyz="0.42 0 0.30" rpy="0 0 0"/>
    </joint>
    <gazebo reference="camera_pan_base">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- 2. SERVO PAN (Khóa tạm fixed) -->
    <link name="camera_pan_link">
        <visual>
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.03 0.04"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.03 0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.05" x="0.03" y="0.03" z="0.04">
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="camera_pan_joint" type="revolute">
        <parent link="camera_pan_base"/>
        <child link="camera_pan_link"/>
        <origin xyz="0 0 0.004" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="2.0"/>
        <dynamics damping="10.0" friction="10.0"/>
    </joint>
    <gazebo reference="camera_pan_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- 3. CÙM GÁ TILT (Chúc nhẹ 12 độ = 0.2094 rad để vừa thấy mũi xe vừa thấy luống) -->
    <link name="camera_tilt_link">
        <visual>
            <origin xyz="0 0 0.015" rpy="0 0 0"/>
            <geometry>
                <box size="0.035 0.04 0.03"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.015" rpy="0 0 0"/>
            <geometry>
                <box size="0.035 0.04 0.03"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.05" x="0.035" y="0.04" z="0.03">
            <origin xyz="0 0 0.015" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="camera_tilt_joint" type="revolute">
        <parent link="camera_pan_link"/>
        <child link="camera_tilt_link"/>
        <origin xyz="0 0 0.04" rpy="0 0.2094 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.7854" upper="0.7854" effort="10.0" velocity="2.0"/>
        <dynamics damping="10.0" friction="10.0"/>
    </joint>
    <gazebo reference="camera_tilt_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- 4. BO MẠCH CAMERA & LENS (IMX296) -->
    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.0198 0.038 0.038"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <visual>
            <origin xyz="0.015 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder radius="0.012" length="0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.01 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.038 0.038"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.034" x="0.038" y="0.038" z="0.0198">
            <origin xyz="0.01 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="camera_tilt_link"/>
        <child link="camera_link"/>
        <origin xyz="0.02 0 0.015" rpy="0 0 0"/>
    </joint>
    <gazebo reference="camera_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- 5. KHUNG QUANG HỌC CHUẨN ROS CHO GAZEBO SENSOR -->
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <link name="camera_link_optical"></link>

    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>1456</width>
                    <height>1088</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>15.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_link_optical</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>