<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>

    <!-- COLOR DEFINITIONS -->
    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <!-- BASE LINK (Tam truc 2 banh chu dong tren mat dat) -->
    <link name="base_link">
    </link>

    <!-- BASE FOOTPRINT -->
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint">
    </link>

    <!-- CHASSIS LINK (Gam cach dat 0.1m, Than xe Cao 0.2m -> Tam o Z = 0.2m) -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="-0.1 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0.25 0 0.2"/>
            <geometry>
                <box size="0.5 0.45 0.2"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.25 0 0.2"/>
            <geometry>
                <box size="0.5 0.45 0.2"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="10.0" x="0.5" y="0.45" z="0.2">
            <origin xyz="0.25 0 0.2" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/White</material>
    </gazebo>

    <!-- LEFT WHEEL LINK (Ban kinh 0.155m, Do day 0.05m) -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.25 0.155" rpy="-${pi/2} 0 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.155" length="0.05"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.155" length="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="1.5" length="0.05" radius="0.155">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_wheel">
        <material>Gazebo/Blue</material>
    </gazebo>

    <!-- RIGHT WHEEL LINK (Ban kinh 0.155m, Do day 0.05m) -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.25 0.155" rpy="${pi/2} 0 0" />
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.155" length="0.05"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.155" length="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="1.5" length="0.05" radius="0.155">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="right_wheel">
        <material>Gazebo/Blue</material>
    </gazebo>

    <!-- ==================== FRONT LEFT SWIVEL CASTER ==================== -->
    <!-- Khop xoay co banh quanh truc Z -->
    <joint name="fl_caster_swivel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="fl_caster_swivel"/>
        <origin xyz="0.45 0.18 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="fl_caster_swivel">
        <visual>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.2" length="0.05" radius="0.03">
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Khop quay banh xe lan quanh truc Y -->
    <joint name="fl_caster_wheel_joint" type="fixed">
        <parent link="fl_caster_swivel"/>
        <child link="fl_caster_wheel"/>
        <origin xyz="-0.03 0 -0.05" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="fl_caster_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.3" length="0.025" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="fl_caster_swivel">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="fl_caster_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="0.1"/>
        <mu2 value="0.1"/>
    </gazebo>

    <!-- ==================== FRONT RIGHT SWIVEL CASTER ==================== -->
    <!-- Khop xoay co banh quanh truc Z -->
    <joint name="fr_caster_swivel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="fr_caster_swivel"/>
        <origin xyz="0.45 -0.18 0.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="fr_caster_swivel">
        <visual>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.2" length="0.05" radius="0.03">
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Khop quay banh xe lan quanh truc Y -->
    <joint name="fr_caster_wheel_joint" type="fixed">
        <parent link="fr_caster_swivel"/>
        <child link="fr_caster_wheel"/>
        <origin xyz="-0.03 0 -0.05" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="fr_caster_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.3" length="0.025" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="fr_caster_swivel">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="fr_caster_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="0.1"/>
        <mu2 value="0.1"/>
    </gazebo>

</robot>