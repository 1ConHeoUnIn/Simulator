<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <!-- Ánh sáng và mặt đất -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ====================================================
         5 LUỐNG ĐẤT VÀ HÀNG CÂY (Khoảng cách tim luống 2.2m)
         Mô đất: Rộng 0.8m, Dài 10m, Cao 0.1m (Lối đi lọt lòng 1.4m)
         Cây: Trụ tròn cao 0.8m đặt trên đỉnh mô đất
         ==================================================== -->

    <!-- LUỐNG 1: X = -4.4m -->
    <model name="bed_and_trees_1">
      <static>true</static>
      <link name="bed_1">
        <pose>-4.4 5.0 0.05 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.8 10.0 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 10.0 0.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
      <link name="t_1_1"><pose>-4.4 1.0 0.5 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link>
